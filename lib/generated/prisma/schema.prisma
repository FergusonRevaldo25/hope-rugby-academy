// Prisma schema for Hope Rugby Academy
// Mirrors lib/content/types.ts exactly so the existing content layer works with zero page changes.

generator client {
  provider = "prisma-client-js"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Coach {
  id        String   @id @default(cuid())
  order     Int      @default(0)
  published Boolean  @default(true)
  name      String
  role      String
  bio       String   @db.Text
  focus     String
  photoSrc  String?
  photoAlt  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AgeGroup {
  id           String   @id @default(cuid())
  order        Int      @default(0)
  published    Boolean  @default(true)
  ageRange     String
  name         String
  focus        String
  photoSrc     String?
  photoAlt     String?
  photoConsent Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Award {
  id           String   @id @default(cuid())
  order        Int      @default(0)
  published    Boolean  @default(true)
  icon         String
  title        String
  description  String   @db.Text
  recipient    String?
  season       String?
  photoSrc     String?
  photoAlt     String?
  photoConsent Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Sponsor {
  id          String   @id @default(cuid())
  order       Int      @default(0)
  published   Boolean  @default(true)
  name        String
  tier        String
  description String   @db.Text
  logoSrc     String?
  logoAlt     String?
  website     String?
  contributed Float?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Fund {
  id          String   @id @default(cuid())
  order       Int      @default(0)
  published   Boolean  @default(true)
  name        String
  icon        String
  goal        Float
  raised      Float    @default(0)
  description String   @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model News {
  id        String   @id @default(cuid())
  order     Int      @default(0)
  published Boolean  @default(true)
  title     String
  excerpt   String   @db.Text
  date      DateTime
  category  String
  photoSrc  String?
  photoAlt  String?
  href      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SessionStep {
  id          String   @id @default(cuid())
  order       Int      @default(0)
  published   Boolean  @default(true)
  time        String
  title       String
  description String   @db.Text
  photoSrc    String?
  photoAlt    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Alert {
  id        String    @id @default(cuid())
  order     Int       @default(0)
  published Boolean   @default(true)
  message   String
  severity  String
  linkLabel String?
  linkHref  String?
  startsAt  DateTime?
  endsAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Event {
  id           String    @id @default(cuid())
  order        Int       @default(0)
  published    Boolean   @default(true)
  title        String
  type         String
  start        DateTime
  end          DateTime?
  venue        String?
  address      String?
  description  String?   @db.Text
  photoSrc     String?
  photoAlt     String?
  photoConsent Boolean   @default(false)
  result       String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Faq {
  id        String   @id @default(cuid())
  order     Int      @default(0)
  published Boolean  @default(true)
  question  String
  answer    String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model BringItem {
  id          String   @id @default(cuid())
  order       Int      @default(0)
  published   Boolean  @default(true)
  icon        String
  title       String
  description String   @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model GalleryItem {
  id           String   @id @default(cuid())
  order        Int      @default(0)
  published    Boolean  @default(true)
  photoSrc     String
  photoAlt     String?
  caption      String?
  photoConsent Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Heading {
  id          String   @id
  eyebrow     String?
  titleBefore String?
  highlight   String?
  titleAfter  String?
  intro       String?  @db.Text
  updatedAt   DateTime @updatedAt
}

model Enquiry {
  id          String   @id @default(cuid())
  childName   String
  ageGroup    String?
  parentName  String
  parentPhone String?
  email       String?
  message     String?  @db.Text
  status      String   @default("new")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
